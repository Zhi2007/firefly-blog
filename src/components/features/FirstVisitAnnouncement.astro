---
// 首次访问弹窗：每个浏览器第一次打开站点时弹出一次，内容包含公告与上游项目致谢
// 配置见 src/config/announcementConfig.ts 的 modal 字段
// 注：Firefly 原版只有侧边栏公告组件，这个弹窗是本仓库新增的自制件
import ProjectCredits from "@components/common/ProjectCredits.astro";
import { announcementConfig } from "@/config";

const modal = announcementConfig.modal;
const title = modal?.title || announcementConfig.title || "公告";
---

{
	modal?.enable && (
		<div
			id="first-visit-announcement"
			class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50 p-4 opacity-0 backdrop-blur-sm transition-opacity duration-300"
			role="dialog"
			aria-modal="true"
			aria-label={title}
		>
			<div class="card-base max-h-[82vh] w-full max-w-lg overflow-y-auto rounded-(--radius-large) p-6 shadow-2xl">
				<div class="mb-3 flex items-start justify-between gap-4">
					<h2 class="text-lg font-bold">{title}</h2>
					<button
						type="button"
						data-announce-close
						class="btn-regular h-8 w-8 shrink-0 rounded-lg text-sm transition-colors"
						aria-label="关闭公告"
					>
						✕
					</button>
				</div>

				<p class="mb-4 text-sm leading-relaxed">
					你好，欢迎来到栀海的博客。本站是从原版
					<a
						class="link text-(--primary)"
						href="https://github.com/CuteLeaf/Firefly"
						target="_blank"
						rel="noopener">Firefly</a
					>
					主题重建而来，公告页里写清了这个站的技术构成，以及所有上游开源项目的作者。
				</p>

				<div class="mb-5 border-t border-dashed border-black/10 pt-4 dark:border-white/15">
					<ProjectCredits />
				</div>

				<div class="flex flex-wrap items-center gap-3">
					<a
						href="/announcement/"
						data-announce-close
						class="btn-regular rounded-lg px-4 py-2 text-sm font-medium transition-transform active:scale-95"
					>
						查看完整公告
					</a>
					<button
						type="button"
						data-announce-close
						class="rounded-lg px-4 py-2 text-sm font-medium text-(--primary) underline decoration-dotted hover:opacity-80"
					>
						我知道了
					</button>
					<span class="text-xs opacity-60" data-announce-close
						>（本提示每个浏览器只弹一次）</span
					>
				</div>
			</div>
		</div>
	)
}

<script>
	import { announcementConfig } from "@/config";

	const modal = announcementConfig.modal;

	if (modal?.enable) {
		const key = modal.storageKey || "announcement-modal-version";
		const version = modal.version || "1";

		let seen = false;
		try {
			seen = localStorage.getItem(key) === version;
		} catch {
			// 隐私模式下 localStorage 不可用：那就每次都弹
		}

		if (!seen) {
			const el = () => document.getElementById("first-visit-announcement");

			const close = () => {
				const node = el();
				if (node) {
					node.classList.add("opacity-0");
					window.setTimeout(() => {
						node.classList.add("hidden");
						node.classList.remove("flex");
					}, 250);
				}
				try {
					localStorage.setItem(key, version);
				} catch {
					// 忽略
				}
			};

			// 事件委托：Swup 换页重建 DOM 后依然有效
			document.addEventListener("click", (e) => {
				const target = e.target as HTMLElement | null;
				if (!target) return;
				if (target.closest("[data-announce-close]")) {
					close();
					return;
				}
				// 点弹窗外的遮罩空白处也能关闭（移动端没有 ESC 键）
				if (target.id === "first-visit-announcement") close();
			});
			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape") close();
			});

			window.setTimeout(() => {
				const node = el();
				if (!node) return;
				node.classList.remove("hidden");
				node.classList.add("flex");
				requestAnimationFrame(() => node.classList.remove("opacity-0"));
			}, modal.delayMs ?? 600);
		}
	}
</script>
