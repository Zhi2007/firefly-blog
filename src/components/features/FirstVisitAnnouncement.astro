---
// 首次访问弹窗：展示「固定公告」（pinned 的那条），因此新发的公告不会把弹窗顶掉
// 配置见 src/config/announcementConfig.ts；Firefly 原版没有这个功能，属本仓库自制件
import ProjectCredits from "@components/common/ProjectCredits.astro";
import { announcementConfig } from "@/config";
import {
	getModalStorageValue,
	resolvePinnedAnnouncement,
	splitParagraphs,
} from "@/utils/announcement-utils";

const modal = announcementConfig.modal;
const item = resolvePinnedAnnouncement(announcementConfig.items);
const title = modal?.title || item?.title || "公告";
const paragraphs = item ? splitParagraphs(item.content) : [];
---

{
	modal?.enable && item && (
		<div
			id="first-visit-announcement"
			class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50 p-4 opacity-0 backdrop-blur-sm transition-opacity duration-300"
			role="dialog"
			aria-modal="true"
			aria-label={title}
		>
			<div class="card-base max-h-[85vh] w-full max-w-xl overflow-y-auto rounded-(--radius-large) p-6 shadow-2xl">
				<div class="mb-3 flex items-start justify-between gap-4">
					<div>
						<h2 class="text-lg font-bold">{title}</h2>
						<div class="mt-1 flex flex-wrap items-center gap-2 text-xs opacity-60">
							<span>{item.published}</span>
							{item.pinned && (
								<span class="rounded-full bg-(--primary)/12 px-2 py-0.5 text-(--primary)">
									固定公告
								</span>
							)}
						</div>
					</div>
					<button
						type="button"
						data-announce-close
						class="btn-regular h-8 w-8 shrink-0 rounded-lg text-sm transition-colors"
						aria-label="关闭公告"
					>
						✕
					</button>
				</div>

				<div class="space-y-3 text-sm leading-relaxed">
					{paragraphs.map((paragraph) => (
						<p>{paragraph}</p>
					))}
				</div>

				{item.links && item.links.length > 0 && (
					<div class="mt-4 flex flex-wrap gap-3">
						{item.links.map((link) => (
							<a
								href={link.url}
								target={link.external ? "_blank" : "_self"}
								rel={link.external ? "noopener noreferrer" : undefined}
								data-announce-close
								class="btn-regular rounded-lg px-4 py-2 text-sm font-medium transition-transform active:scale-95"
							>
								{link.text}
							</a>
						))}
					</div>
				)}

				<details class="mt-5 border-t border-dashed border-black/10 pt-3 dark:border-white/15">
					<summary class="cursor-pointer text-sm font-medium opacity-80">
						开源项目与作者致谢（点击展开）
					</summary>
					<div class="mt-3">
						<ProjectCredits />
					</div>
				</details>

				<div class="mt-5 flex flex-wrap items-center gap-3">
					<button
						type="button"
						data-announce-close
						class="rounded-lg px-4 py-2 text-sm font-medium text-(--primary) underline decoration-dotted hover:opacity-80"
					>
						我知道了
					</button>
					<span class="text-xs opacity-60">（本提示每个浏览器只弹一次）</span>
				</div>
			</div>
		</div>
	)
}

<script>
	import { announcementConfig } from "@/config";
	import {
		getModalStorageValue,
		resolvePinnedAnnouncement,
	} from "@/utils/announcement-utils";

	const modal = announcementConfig.modal;
	// 弹窗认准「固定公告」：新发的公告不会让老访客再看到一次弹窗
	const item = resolvePinnedAnnouncement(announcementConfig.items);

	if (modal?.enable && item) {
		const storageValue = getModalStorageValue(announcementConfig, item);

		let seen = false;
		try {
			// 记录的是「固定公告 id + 版本号」：换了固定公告或改了 version 就会重新弹
			seen = localStorage.getItem(storageValue) === "1";
		} catch {
			// 隐私模式下 localStorage 不可用：那就每次都弹
		}

		if (!seen) {
			const el = () => document.getElementById("first-visit-announcement");

			const close = () => {
				const node = el();
				if (node) {
					node.classList.add("opacity-0");
					window.setTimeout(() => {
						node.classList.add("hidden");
						node.classList.remove("flex");
					}, 250);
				}
				try {
					localStorage.setItem(storageValue, "1");
				} catch {
					// 忽略
				}
			};

			// 事件委托：Swup 换页重建 DOM 后依然有效
			document.addEventListener("click", (e) => {
				const target = e.target as HTMLElement | null;
				if (!target) return;
				if (target.closest("[data-announce-close]")) {
					close();
					return;
				}
				// 点弹窗外的遮罩空白处也能关闭（移动端没有 ESC 键）
				if (target.id === "first-visit-announcement") close();
			});
			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape") close();
			});

			window.setTimeout(() => {
				const node = el();
				if (!node) return;
				node.classList.remove("hidden");
				node.classList.add("flex");
				requestAnimationFrame(() => node.classList.remove("opacity-0"));
			}, modal.delayMs ?? 600);
		}
	}
</script>
