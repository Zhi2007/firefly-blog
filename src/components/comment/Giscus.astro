---
import { commentConfig } from "@/config";

if (!commentConfig?.giscus) {
	throw new Error("Giscus comments are not configured");
}

const giscus = commentConfig.giscus;
const lightTheme = "light";
const darkTheme = "dark";
---

<!-- 
  Giscus 官方Web Component用法，兼容Astro静态输出，无需import包，无需NPM依赖！
  参考：https://giscus.app/ 详情配置说明
-->
<giscus-widget
  id="comments"
  repo={giscus.repo}
  repoId={giscus.repoId}
  category={giscus.category}
  categoryId={giscus.categoryId}
  mapping={giscus.mapping}
  strict={giscus.strict}
  reactionsEnabled={giscus.reactionsEnabled}
  emitMetadata={giscus.emitMetadata}
  inputPosition={giscus.inputPosition}
  theme={lightTheme}
  lang={giscus.lang}
  loading={giscus.loading}
/>

<script is:inline define:vars={{ lightTheme, darkTheme }}>
  // Giscus 用官方 Web Component（<giscus-widget>），本脚本负责三件事：
  //   1) 支持 ?path=xxx 指定评论映射
  //   2) 跟随站点深浅色切换主题
  //   3) ★ Swup 页面切换后重新初始化
  // 注意（曾经的 bug）：
  //   a. 原实现只在脚本执行时 querySelector 一次并长期持有引用 —— 换页后那个节点已被替换，
  //      引用失效会让评论区不再加载、主题也不再跟随。这里改成每次都重新查询。
  //   b. 自定义元素靠 import 注册，换页后要再 import 一次（浏览器会命中模块缓存，幂等）。
  //   c. 脚本已自托管在 public/vendor/giscus-<版本>.mjs（不依赖任何外部 CDN）。
  //      升级方式：下载新版本、改这里的文件名与下面 import 的路径即可（文件名带版本号，可长期缓存）。

  function currentWidget() {
    return document.querySelector("giscus-widget");
  }

  function applyRequestedPath() {
    const requestedPath = new URLSearchParams(window.location.search).get("path");
    const widget = currentWidget();
    if (requestedPath && widget) {
      widget.setAttribute("mapping", "specific");
      widget.setAttribute("term", requestedPath);
    }
  }

  function updateGiscusTheme() {
    const widget = currentWidget();
    if (!widget) return;
    const theme = document.documentElement.classList.contains("dark") ? darkTheme : lightTheme;
    widget.setAttribute("theme", theme);
  }

  function initGiscus() {
    applyRequestedPath();
    updateGiscusTheme();
    import("/vendor/giscus-1.6.0.mjs").catch((error) => {
      console.warn("[giscus] 脚本加载失败（检查 /vendor/giscus-1.6.0.mjs 是否已部署）:", error);
    });
  }

  // 深浅色观察器只建一次；回调里每次重新查询 widget，避免持有失效引用
  if (!window.giscusThemeObserver) {
    window.giscusThemeObserver = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        if (mutation.type === "attributes" && mutation.attributeName === "class") {
          updateGiscusTheme();
        }
      }
    });
    window.giscusThemeObserver.observe(document.documentElement, { attributes: true });
  }

  initGiscus();
  // 主题在页面切换后会派发这个事件；同时兼容 Swup 钩子与脚本被重新执行的情况
  document.addEventListener("firefly:page:loaded", initGiscus);
  document.addEventListener("swup:enable", () => {
    if (window.swup && window.swup.hooks) window.swup.hooks.on("content:replace", initGiscus);
  });
  if (window.swup && window.swup.hooks) window.swup.hooks.on("content:replace", initGiscus);
</script>
