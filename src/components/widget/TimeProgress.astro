---
// 侧边栏「时间进度」组件：今日 / 本月 / 本年已过百分比，按访客本地时区实时计算
// 组件挂载在 sidebarConfig.ts 的 leftComponents（type: "timeProgress"）
// 具体文案与开关见 src/config/effectsConfig.ts 的 timeProgressConfig
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { timeProgressConfig } from "@/config";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;

const rows = [
	{ kind: "day", label: timeProgressConfig.labels.day },
	{ kind: "month", label: timeProgressConfig.labels.month },
	{ kind: "year", label: timeProgressConfig.labels.year },
];
---

{
	timeProgressConfig.enable && (
		<WidgetLayout
			name={timeProgressConfig.title || "时间进度"}
			showTitle={showTitle}
			id="time-progress"
			class={className}
			style={style}
		>
			<div class="space-y-3 pb-1">
				{rows.map((row) => (
					<div data-kind={row.kind}>
						<div class="mb-1.5 flex items-baseline justify-between gap-2">
							<span class="text-sm text-neutral-600 dark:text-neutral-300">
								{row.label}
							</span>
							<span class="text-xs tabular-nums text-(--primary)" data-text>
								计算中…
							</span>
						</div>
						<span class="block h-1.5 overflow-hidden rounded-full bg-black/10 dark:bg-white/15">
							<i class="block h-full w-0 rounded-full bg-(--primary) transition-[width] duration-500 ease-linear" />
						</span>
						<span class="mt-1 block text-[11px] opacity-60" data-remaining />
					</div>
				))}
			</div>
		</WidgetLayout>
	)
}

<script>
	import { timeProgressConfig } from "@/config";

	if (timeProgressConfig.enable) {
		const cfg = timeProgressConfig;

		const render = () => {
			const box = document.getElementById("time-progress");
			if (!box) return;

			const now = new Date();

			const dayStart = new Date(now);
			dayStart.setHours(0, 0, 0, 0);
			const dayEnd = new Date(dayStart);
			dayEnd.setDate(dayEnd.getDate() + 1);

			const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
			const monthEnd = new Date(now.getFullYear(), now.getMonth() + 1, 1);

			const yearStart = new Date(now.getFullYear(), 0, 1);
			const yearEnd = new Date(now.getFullYear() + 1, 0, 1);

			const spans: Record<string, [Date, Date]> = {
				day: [dayStart, dayEnd],
				month: [monthStart, monthEnd],
				year: [yearStart, yearEnd],
			};

			for (const kind of Object.keys(spans)) {
				const row = box.querySelector(`[data-kind="${kind}"]`);
				if (!row) continue;

				const [start, end] = spans[kind];
				const total = end.getTime() - start.getTime();
				const passed = now.getTime() - start.getTime();
				const pct = Math.min(100, Math.max(0, (passed / total) * 100));

				const fill = row.querySelector("i");
				if (fill) (fill as HTMLElement).style.width = `${pct}%`;

				// 百分比：今日保留一位小数，本月/本年保留两位
				const text = row.querySelector("[data-text]");
				if (text) text.textContent = `${pct.toFixed(kind === "day" ? 1 : 2)}%`;

				// 剩余时间：统一用「距离下一X还剩」的句式
				// 今日「X时X分」，本月「X 天 Y 小时」，本年「X 天」
				const remain = row.querySelector("[data-remaining]");
				if (remain && cfg.showRemaining) {
					const left = Math.max(0, end.getTime() - now.getTime());
					if (kind === "day") {
						const hours = Math.floor(left / 3600000);
						const minutes = Math.floor((left % 3600000) / 60000);
						remain.textContent = `距离下一天还剩 ${hours}时${minutes}分`;
					} else if (kind === "month") {
						remain.textContent = `距离下一月还剩 ${Math.floor(
							left / 86400000,
						)} 天 ${Math.floor((left % 86400000) / 3600000)} 小时`;
					} else {
						remain.textContent = `距离下一年还剩 ${Math.ceil(left / 86400000)} 天`;
					}
				}
			}
		};

		// Swup 切页会重新执行这个模块，先清掉旧定时器再装新的，保证只有一个
		const w = window as unknown as { __timeProgressTimer?: number };
		if (w.__timeProgressTimer) window.clearInterval(w.__timeProgressTimer);
		render();
		w.__timeProgressTimer = window.setInterval(render, 1000);
	}
</script>
