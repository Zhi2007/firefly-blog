---
// 公告页：顶部导航栏「公告」栏目指向这里
// 公告列表来自 src/config/announcementConfig.ts（固定公告排最前）
// 致谢清单由共用的 ProjectCredits 组件渲染
import { getEntry, render } from "astro:content";
import AnnouncementList from "@components/common/AnnouncementList.astro";
import Markdown from "@components/common/Markdown.astro";
import ProjectCredits from "@components/common/ProjectCredits.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const entry = await getEntry("spec", "announcement");

if (!entry) {
	throw new Error("Announcement page content not found");
}

const { Content } = await render(entry);
---

<MainGridLayout title="公告" description="本站公告、免责声明与开源项目致谢">
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 py-6 relative w-full md:px-9">
      <AnnouncementList />
      <Markdown class="mt-8">
        <Content />
      </Markdown>
      <ProjectCredits />
    </div>
  </div>
</MainGridLayout>
