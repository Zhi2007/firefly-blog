{
	"name": "my-blog",
	"main": "worker/index.mjs",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Worker 接管所有请求：裸域 301 到 www、旧地址 301、音乐 Range、安全响应头都在 worker/index.mjs 里实现
		// （_redirects / _headers 不作用于 Worker 处理的响应，所以这几件事不能靠它们）
		"run_worker_first": true
	},
	// 自有域名：域名已托管在 Cloudflare，部署时会自动创建 DNS 记录并签发证书。
	// 旧的 my-blog.mc20070831.workers.dev 继续可用。
	"routes": [
		{
			"pattern": "zhihaisblog.top",
			"custom_domain": true
		},
		{
			"pattern": "www.zhihaisblog.top",
			"custom_domain": true
		}
	]
}
